# Normalize line endings stored in the repository.
* text=auto

# Shell scripts must keep LF so they run on macOS / Linux / WSL.
*.sh text eol=lf

# Windows launchers.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
